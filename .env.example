# 复制为 .env 后填写
# 大模型（任何 OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 网页访问口令（放到公网时必须设）：打开 http://host:8080/?token=口令
WEB_TOKEN=

# 允许 Agent 在沙箱里写代码做分析（1 开 / 0 关）
ALLOW_CODE=1

# 定时报告（北京时间，工作日）
REPORT_TIMES=morning=08:30,evening=21:00

# 推送 / 聊天渠道（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # 只回复这些 chat id，逗号分隔
SERVERCHAN_KEY=
WECOM_WEBHOOK=
FEISHU_WEBHOOK=

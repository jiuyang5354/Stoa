# 复制为 .env 后填写（docker compose 会自动读取）

# ============ 大模型 ============
# 预设：deepseek openai anthropic gemini qwen kimi zhipu doubao hunyuan minimax stepfun baichuan
#       siliconflow openrouter groq together fireworks mistral xai perplexity ollama lmstudio vllm azure
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选：覆盖模型 / 地址（中转、自建网关、Ollama 在宿主机时用 http://host.docker.internal:11434/v1）
LLM_MODEL=
LLM_BASE_URL=
# 主模型出错时依次换用，格式 预设名[:模型]，各家密钥用自己的变量名，如 DASHSCOPE_API_KEY
LLM_FALLBACK=
# AZURE_API_VERSION=2024-10-21
# OpenAI 兼容中转示例（不要把密钥提交到仓库）：
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://sui-xiang.com/v1
#   LLM_MODEL=gpt-6.1-terra
#   LLM_CONTEXT=200000        # 上下文窗口（token），中转不报就手填
#   EMBEDDINGS=local          # 中转没有 /v1/embeddings 时用本地向量
# 429 限流 / 5xx 时退避重试次数（默认 3）
LLM_RETRIES=

# ============ 行情源（按顺序尝试，拿到足够历史就停） ============
# 可选：yahoo eastmoney tushare finnhub alphavantage polygon twelvedata tiingo fmp custom
DATA_PROVIDERS=tencent,eastmoney,akshare,yahoo
TUSHARE_TOKEN=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
TWELVEDATA_API_KEY=
TIINGO_API_KEY=
FMP_API_KEY=
# 自建接口：{symbol} {days} 占位，返回 [{"date":"2026-10-28","close":123.4}, ...]
DATA_CUSTOM_URL=
DATA_CUSTOM_TOKEN=

# ============ 访问与对外接口 ============
# 网页 / OpenAI 兼容接口 / MCP 的口令（放到公网时必须设）
WEB_TOKEN=
# 允许浏览器跨域调用接口时填来源，如 https://example.com 或 *
CORS_ORIGIN=

# 允许 Agent 写 Python 做离线分析（1 开 / 0 关）
ALLOW_CODE=0
# 代码执行环境：auto = 有 Docker 镜像就用容器，没有时退回本机受限模式；docker = 只用 Docker（见 README）
CODE_SANDBOX=auto

# 深度分析（Agora）分角色模型：留空 = 所有角色用上面的默认模型（与以前一样）。
# 写「模型名」沿用默认服务商的地址和密钥，写「服务商:模型名」换服务商（如 deepseek:deepseek-chat）。
# 分析师 = 四位分析师 + 多空研究员；裁决 = 风控官、基金经理、核对修订。调用次数不变。
DEBATE_ANALYST_MODEL=
DEBATE_JUDGE_MODEL=

# 定时报告（北京时间，工作日）
REPORT_TIMES=morning=08:30,evening=21:00
# 错过的报告（没开机 / 睡眠）开机后补发并标「补发」；超过时限的跳过
REPORT_CATCHUP=on
REPORT_MAX_LATE=morning=3,evening=12
# 早报判断的周期（交易日），到期自动结算
REPORT_CALL_DAYS=5
# 定时任务错过多久以内补跑（小时）
TASK_CATCHUP_HOURS=6
# 第一次往新开的推送渠道发消息前要你批准（on / off）
PUSH_CONFIRM_NEW=on

# ============ 推送 / 聊天渠道（填哪个推哪个） ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # 只回复这些 chat id，逗号分隔
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
WECOM_WEBHOOK=
FEISHU_WEBHOOK=
DINGTALK_WEBHOOK=
BARK_KEY=
NTFY_TOPIC=
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
WEBHOOK_URL=               # 通用：POST {"title","markdown"}

# ============ 更深的数据（v0.16，可不填） ============
QUOTE_CROSSCHECK=on        # 报价多源交叉校验（off 关闭）
QUOTE_DIFF_PCT=0.5         # 两源报价偏差超过多少 % 写提醒
FLOW_DIFF_PCT=35           # 资金流两源差异阈值（两家主力口径不同，放宽）
EPS_DIFF_PCT=10            # EPS 预测两源差异阈值
DEBATE_FILINGS=on          # 深度分析时基本面分析师对比最近两年年报风险因素
DEBATE_FILING_TIMEOUT=25   # 首次下载年报的限时（秒），超时跳过、后台继续缓存

# ============ 语义记忆 / 长对话 / 财报事件（v0.17，可不填） ============
EMBEDDINGS=auto            # auto：模型服务商支持 embeddings 就用，否则本地 TF-IDF 向量；local / off
# EMBED_PROVIDER=siliconflow   # 单独指定嵌入服务（预设名），或用 EMBED_BASE_URL + EMBED_API_KEY + EMBED_MODEL
# EMBED_MODEL=BAAI/bge-m3
# LLM_CONTEXT=64000          # 覆盖模型上下文窗口（token）；长对话按窗口 × CONTEXT_RATIO 压缩
# CONTEXT_RATIO=0.6
# CONTEXT_BUDGET=            # 直接指定输入预算（token）
# AGENT_MAX_ROUNDS=12        # 工具循环上限
EARNINGS=on                # 财报日跟踪、财报前提醒、财报后自动研报（off 关闭）
EARNINGS_REMIND_DAYS=3
# EARNINGS_DEBATE=0          # 研报后顺带跑一次 Agora 辩论
